{
  "name": "Email Dash",
  "description": "Because email is terrible: a skinner's box for your inbox.",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": [
        "dev-tools/dom-snapshot.js",
        "dev-tools/smoke-test.js"
      ],
      "matches": ["*://mail.google.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "css": ["my-styles.css"],
      "js": [
        "content-script.js"
      ]
    }
  ]
}